@startuml
title 4+1 - Vue Logique (domaine détaillé + ports d'application) — État actuel ✅ + Phase 2 ⏳

hide stereotype
skinparam class {
  BackgroundColor<<APP>> #FBE6A2
  BackgroundColor<<ID>>  #D3E5FF
  BackgroundColor<<SEC>> #FBE6A2
  BackgroundColor<<PFR>> #F5BAB5
  BackgroundColor<<OBS>> #EDE7F6
}

' =======================
' Application (ports = contrats d'UC)
' =======================
package "Application (ports entrants)" {
  interface "ISignupUseCase\n(UC-01 ✅)" as ISignupUseCase <<APP>>
  interface "IAuthUseCase\n(UC-02 ✅)" as IAuthUseCase <<APP>>
  interface "IDepositUseCase\n(UC-03 🔄)" as IDepositUseCase <<APP>>
  
  note right of IDepositUseCase
    🔄 Manque idempotency-key
    À implémenter: 
    - Header Idempotency-Key
    - Table IdempotencyKeys
    - Constraint unique sur (accountId, key)
  end note
}

' =======================
' Identite & Comptes (Bounded Context)
' =======================
package "Identite & Comptes (BC)" {
  class Client <<ID>> {
    +clientId: UUID
    +email: String
    +telephone: String
    +nomComplet: String
    +dateNaissance: Date
    +statut: StatutClient
    +createdAt: DateTime
    +updatedAt: DateTime
    --
    +Creer(): Client
    +DemarrerKycSiNecessaire()
    +DemarrerOtpActivation(): VerifContactOTP
    +ActiverSiAdmissible()
    +OuvrirCompte(): Compte
  }

  class Compte <<ID>> {
    +accountId: UUID
    +clientId: UUID
    +accountNo: String
    +statut: StatutCompte
    +createdAt: DateTime
    --
    +Ouvrir(): Compte
    +Activer()
    +Suspendre(raison: String)
  }

  class "DossierKYC" as DossierKYC <<ID>> {
    +kycId: UUID
    +clientId: UUID
    +niveau: NiveauKYC
    +statut: StatutKYC
    +updatedAt: DateTime
    --
    +Soumettre()
    +Approuver()
    +Rejeter(raison: String)
  }

  class "VerifContactOTP" as VerifContactOTP <<ID>> {
    +otpId: UUID
    +clientId: UUID
    +canal: CanalOTP
    +codeHash: String
    +statut: StatutOTP
    +expiresAt: DateTime
    --
    +Generer(ttl: TimeSpan): String
    +Verifier(code: String): bool
    +Expirer()
  }
  
  Client "1" --> "*" Compte : possède
  Client "1" --> "0..1" DossierKYC : a
  Client "1" --> "*" VerifContactOTP : génère
}

' =======================
' Securite (Auth/MFA) (Bounded Context)
' =======================
package "Securite (Auth/MFA) (BC)" {
  class Session <<SEC>> {
    +sessionId: UUID
    +clientId: UUID
    +tokenType: String
    +tokenHash: String
    +issuedAt: DateTime
    +expiresAt: DateTime
    +ip: String
    +device: String
    --
    +Emettre(): String
    +Valider(token: String): bool
    +Revoquer()
  }

  class "PolitiqueMFA" as MFAPolicy <<SEC>> {
    +mfaId: UUID
    +clientId: UUID
    +type: TypeMFA
    +estActive: Boolean
    +createdAt: DateTime
    --
    +Activer()
    +Desactiver()
  }

  class "DefiMFA" as MFAChallenge <<SEC>> {
    +challengeId: UUID
    +sessionId: UUID
    +type: TypeMFA
    +codeHash: String
    +statut: StatutChallenge
    +createdAt: DateTime
    +expiresAt: DateTime
    --
    +Generer(ttl: TimeSpan): String
    +Verifier(code: String): bool
  }
  
  Client "1" --> "*" Session : authentifié par
  Client "1" --> "0..1" MFAPolicy : configure
  Session "1" --> "0..1" MFAChallenge : nécessite
}

' =======================
' Portefeuille & Reglement (Bounded Context)
' =======================
package "Portefeuille & Reglement (BC)" {
  class Portefeuille <<PFR>> {
    +portfolioId: UUID
    +accountId: UUID
    +soldeMonnaie: Decimal
    +devise: String
    +updatedAt: DateTime
    --
    +Crediter(montant: Decimal)
    +Debiter(montant: Decimal)
    +VerifierSoldeSuffisant(montant: Decimal): bool
  }

  class "TransactionPaiement" as PayTx <<PFR>> {
    +paymentTxId: UUID
    +accountId: UUID
    +amount: Decimal
    +currency: String
    +statut: StatutPaiement
    +idempotencyKey: String ⚠️
    +createdAt: DateTime
    +settledAt: DateTime?
    --
    +Initier(key: String): PayTx
    +Confirmer()
    +Echouer(raison: String)
  }
  
  note right of PayTx
    ⚠️ idempotencyKey doit avoir:
    - Index unique (accountId, idempotencyKey)
    - Validation non-null/non-vide
    - Retry safe: même key → même résultat
  end note

  class "EcritureLedger" as Ledger <<PFR>> {
    +ledgerEntryId: UUID
    +accountId: UUID
    +amount: Decimal
    +currency: String
    +kind: TypeEcriture
    +refType: String
    +refId: UUID
    +createdAt: DateTime
    --
    +Enregistrer(): Ledger
    {static} +EstAppendOnly(): bool
  }
  
  note right of Ledger
    Ledger = Journal immuable (append-only)
    Pas de UPDATE/DELETE
    Audit trail complet
  end note
  
  Compte "1" --> "1" Portefeuille : a
  Compte "1" --> "*" PayTx : effectue
  PayTx "1" --> "1..*" Ledger : génère
}

' =======================
' Observabilite & Audit (Bounded Context)
' =======================
package "Observabilite & Audit (BC)" {
  class AuditLog <<OBS>> {
    +auditId: UUID
    +eventType: String
    +actor: String
    +accountId: UUID
    +resourceType: String
    +resourceId: UUID
    +payloadJson: Text
    +createdAt: DateTime
    --
    +Enregistrer(): AuditLog
    {static} +EstAppendOnly(): bool
  }
  
  note left of AuditLog
    Événements critiques à auditer:
    - Création compte (UC-01)
    - Authentification (UC-02)
    - Dépôts/retraits (UC-03)
    - Changement statut
    - Actions admin
  end note
  
  class "MetricsExporter\n(Phase 2 ⏳)" as Metrics <<OBS>> {
    +ExporterPrometheus()
    +Mesurer4GoldenSignals()
    --
    Latence: P50/P95/P99
    Trafic: RPS par endpoint
    Erreurs: % 4xx/5xx
    Saturation: CPU/RAM/threads
  }
  
  class "LogsStructures\n(Phase 2 ⏳)" as StructuredLogs <<OBS>> {
    +LogJSON(level, message, context)
    --
    Format: JSON avec:
    - timestamp
    - traceId
    - userId/accountId
    - endpoint
    - latency
    - statusCode
  }
}

' =======================
' Dependances logiques (ports -> domaine)
' =======================
ISignupUseCase --> Client
ISignupUseCase --> Compte
ISignupUseCase --> DossierKYC
ISignupUseCase --> VerifContactOTP
ISignupUseCase --> AuditLog

IAuthUseCase --> Client
IAuthUseCase --> MFAPolicy
IAuthUseCase --> MFAChallenge
IAuthUseCase --> Session
IAuthUseCase --> AuditLog

IDepositUseCase --> PayTx
IDepositUseCase --> Portefeuille
IDepositUseCase --> Ledger
IDepositUseCase --> AuditLog

' Observabilité utilisée par tous les UC
ISignupUseCase ..> Metrics : expose
IAuthUseCase ..> Metrics : expose
IDepositUseCase ..> Metrics : expose

ISignupUseCase ..> StructuredLogs : log
IAuthUseCase ..> StructuredLogs : log
IDepositUseCase ..> StructuredLogs : log

legend right
  **État d'implémentation**:
    ✅ UC-01 (Inscription): Controller → Service → Domaine (Client/Compte/KYC/OTP)
    ✅ UC-02 (Authentification): Controller → Service → Domaine (Session/MFA)
    🔄 UC-03 (Dépôts): Partiel, manque idempotency-key + tests E2E
    ⏳ Observabilité (Metrics/Logs structurés) — TODO #5
  
  **Bounded Contexts (DDD)**:
    - Identité & Comptes: gestion clients/comptes
    - Sécurité: auth/sessions/MFA
    - Portefeuille: soldes/transactions/ledger
    - Observabilité: audit/metrics/logs
  
  **Prochaines actions (TODO #3)**:
    1. Ajouter propriété idempotencyKey à PayTx
    2. Créer migration + index unique (accountId, idempotencyKey)
    3. Implémenter logique idempotence dans WalletService
    4. Tests E2E: retry avec même key → même résultat
  
  **Architecture Hexagonale**:
    - Ports entrants (ISignupUseCase, etc.) = contrats Application
    - Domaine = règles métier pures (Client, Compte, PayTx, etc.)
    - Dépendances dirigées: UI → App → Domain ← Infra
end legend

@enduml

' =======================
' Associations de domaine
' =======================
Client "1" -- "1..*" Compte : Possede >
Client "1" -- "0..1" DossierKYC : Dossier >
Client "1" -- "0..*" VerifContactOTP : Verifie le contact >
Client "1" -- "0..*" Session : Ouvre >
Client "1" -- "0..1" MFAPolicy : Configure >
Client "1" -- "0..*" MFAChallenge : Declenche >

Compte "1" -- "1" Portefeuille : Detient >
Compte "1" -- "0..*" PayTx : Initie >
Compte "1" -- "0..*" Ledger : Affecte >

PayTx "1" -- "1..*" Ledger : Provoque >
AuditLog "*" -- "0..1" Compte : Concerne >

legend right
  **Vue Logique (4+1) – Intention**
  Montre la structure conceptuelle : 
    • Domaine (entites/agregats)
    • Contrats d’application (ports de cas d’utilisation)
    • Relations logiques (quels ports manipulent quelles classes)

  **Ce que la vue NE montre pas**
    • Implémentations concretes (services, controllers)
    • Adapters, base de données, frameworks
    • Flèches de realisation (A -|> I)

  **Convention des flèches**
    Port --> ClasseDeDomaine : le cas d’utilisation manipule cet element
    A -- B (multiplicites)  : association de domaine

  **Pourquoi pas de "A -|> I" ici ?**
    La realisation (implémente) est une decision d’assemblage 
    montrees dans la vue Composants & Connecteurs (C&C).
    On evite la redondance et on garde la vue logique agnostique.

  **Où voir les implémentations ?**
    Dans la vue C&C : ex. SignupService -|> ISignupUseCase
end legend


@enduml
