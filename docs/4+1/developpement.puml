  }
  package "MarketFeed" #FCE4EC {
    class "MarketFeedSimAdapter.cs ✨" as MarketFeedAdapter
  }
  package "Session" {
    class "JwtSessionAdapter.cs" as SessionAdapter
  }
  package "Audit" {
