@startuml
title 4+1 - Vue Développement (Structure des projets .NET + dépendances)

skinparam packageStyle rectangle
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80

' =======================
' LAYER 1: DOMAIN (Centre - Pas de dépendances)
' =======================
package "BrokerX.Domain" as Domain #E8F5E9 {
  package "Model" as DomModel {
    package "Identite" as ModelId {
      class "Client.cs" as ClientCs
      class "Compte.cs" as CompteCs
      class "DossierKYC.cs" as KycCs
      class "VerifContactOTP.cs" as OtpCs
    }
    package "Securite" as ModelSec {
      class "Session.cs" as SessionCs
      class "PolitiqueMFA.cs" as MfaPolicyCs
      class "DefiMFA.cs" as MfaChallengeCs
    }
    package "PortefeuilleReglement" as ModelPfr {
      class "Portefeuille.cs" as PortfolioCs
      class "TransactionPaiement.cs" as PayTxCs
      class "EcritureLedger.cs" as LedgerCs
    }
    package "Trading" as ModelTrd #F1F8E9 {
      class "Ordre.cs ✨" as OrderCs
      class "Execution.cs ✨" as ExecCs
      class "Position.cs ✨" as PositionCs
    }
    package "MarketData" as ModelMkt #FCE4EC {
      class "Quote.cs ✨" as QuoteCs
      class "Subscription.cs ✨" as SubCs
    }
    package "Observabilite" as ModelObs {
      class "AuditLog.cs" as AuditCs
    }
  }
  
  package "Ports.Inbound" as DomIn {
    interface "ISignupUseCase.cs" as ISignup
    interface "IAuthUseCase.cs" as IAuth
    interface "IDepositUseCase.cs" as IDeposit
    interface "IMarketDataUseCase.cs ✨" as IMarket
    interface "IOrderUseCase.cs ✨" as IOrder
  }
  
  package "Ports.Outbound" as DomOut {
    ' Repositories
    interface "IClientRepository.cs" as IClientRepo
    interface "IAccountRepository.cs" as IAccountRepo
    interface "IPortfolioRepository.cs" as IPortfolioRepo
    interface "IPayTxRepository.cs" as IPayTxRepo
    interface "IOrderRepository.cs ✨" as IOrderRepo
    interface "IPositionRepository.cs ✨" as IPositionRepo
    interface "IQuoteRepository.cs ✨" as IQuoteRepo
    interface "ISubscriptionRepository.cs ✨" as ISubRepo
    
    ' External services
    interface "IOtpPort.cs" as IOtpPort
    interface "IKycPort.cs" as IKycPort
    interface "IPaymentPort.cs" as IPaymentPort
    interface "IMarketFeedPort.cs ✨" as IMarketFeedPort
    
    ' Infrastructure services
    interface "ISessionPort.cs" as ISessionPort
    interface "IAuditPort.cs" as IAuditPort
    interface "ILedgerPort.cs" as ILedgerPort
  }
  
  package "Contracts" as DomContracts {
    class "SignupResult.cs" as SignupResult
    class "LoginResult.cs" as LoginResult
    class "DepositResult.cs" as DepositResult
    class "MarketDataResult.cs ✨" as MarketResult
    class "OrderResult.cs ✨" as OrderResult
  }
}

' =======================
' LAYER 2: APPLICATION (Orchestration)
' =======================
package "BrokerX.Application" as App #FFF9C4 {
  package "Services" as AppSvc {
    class "SignupService.cs" as SignupSvc
    class "AuthService.cs" as AuthSvc
    class "WalletService.cs" as WalletSvc
    class "MarketDataService.cs ✨" as MarketSvc
    class "OrderService.cs ✨" as OrderSvc
  }
  
  package "DTOs" as AppDto {
    note "Request/Response DTOs\nValidation attributes" as DtoNote
  }
}

' =======================
' LAYER 3: INFRASTRUCTURE WEB (API)
' =======================
package "BrokerX.Infrastructure.Web" as Web #BBDEFB {
  package "Controllers" as WebCtl {
    class "SignupController.cs\n(UC-01)" as SignupCtrl
    class "AuthController.cs\n(UC-02)" as AuthCtrl
    class "WalletController.cs\n(UC-03)" as WalletCtrl
    class "MarketDataController.cs ✨\n(UC-04)" as MarketCtrl
    class "OrdersController.cs ✨\n(UC-05)" as OrdersCtrl
    class "PaymentWebhookController.cs" as WebhookCtrl
  }
  
  package "Hubs" as WebHubs #FCE4EC {
    class "MarketDataHub.cs ✨\n(WebSocket)" as MarketHub
  }
  
  package "DTOs" as WebDto {
    note "API Request/Response\nOpenAPI/Swagger" as WebDtoNote
  }
  
  package "Middleware" as WebMw {
    class "ErrorHandlingMiddleware.cs" as ErrorMw
    class "AuthenticationMiddleware.cs" as AuthMw
  }
  
  class "Program.cs" as Program
  class "appsettings.json" as AppSettings
}

' =======================
' LAYER 4: INFRASTRUCTURE PERSISTENCE (Repositories + EF Core)
' =======================
package "BrokerX.Infrastructure.Persistence" as Persist #FFE0B2 {
