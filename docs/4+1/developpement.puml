  }
}

' =======================
' LAYER 6: TESTS
' =======================
package "Tests" as Tests #E1BEE7 {
  package "Domain.Tests" as DomainTests {
    class "UnitTest1.cs" as DomainUnit1
    note "Tests unitaires entités domaine\n(À créer pour UC-04/05)" as DomainNote
    class "OrderTests.cs ✨" as OrderTests
    class "PositionTests.cs ✨" as PositionTests
  }
  
  package "Application.Tests" as AppTests {
    class "UnitTest1.cs" as AppUnit1
    note "Tests unitaires services\n(À créer pour UC-04/05)" as AppNote
    class "MarketDataServiceTests.cs ✨" as MarketSvcTests
    class "OrderServiceTests.cs ✨" as OrderSvcTests
  }
  
  package "E2E.Tests" as E2ETests {
    class "SimpleE2ETests.cs" as SimpleE2E
    note right of SimpleE2E
      Tests E2E existants:
      - POST_Signup_WithValidData
      - POST_Login_WithValidCredentials
      - POST_Deposit_WithValidData
      (UC-01, UC-02, UC-03)
    end note
    
    class "MarketDataSubscriptionTests.cs ✨" as E2EMarketTests
    class "OrderPlacementTests.cs ✨" as E2EOrderTests
  }
  
  package "Infrastructure.Tests" as InfraTests {
    class "UnitTest1.cs" as InfraUnit1
    class "RedisCacheAdapterTests.cs" as CacheTests
    class "RedisCachePerformanceTests.cs" as PerfTests
    note right of CacheTests
      Tests cache Redis existants
    end note
  }
}

' ===========================
' DÉPENDANCES INTER-PROJETS (flèches épaisses)
' ===========================
Web =down=> App       : <<access>>
App =down=> Domain    : <<access>>
Persist =down=> Domain: <<access>>
Adapters =down=> Domain: <<access>>

Tests =down=> Domain : <<access>>
Tests =down=> App : <<access>>
Tests =down=> Web : <<access>>

' ===========================
' DÉPENDANCES INTRA-PROJETS (flèches fines)
' ===========================
' Controllers -> Ports Inbound
SignupCtrl ..> ISignup : <<import>>
AuthCtrl ..> IAuth : <<import>>
WalletCtrl ..> IDeposit : <<import>>
MarketCtrl ..> IMarket : <<import>>
OrdersCtrl ..> IOrder : <<import>>
MarketHub ..> IMarket : <<import>>

' Services -> Domain Model
AppSvc ..> DomModel : <<import>>
AppSvc ..> DomContracts : <<import>>

' Services implement Ports Inbound
SignupSvc ..|> ISignup
AuthSvc ..|> IAuth
WalletSvc ..|> IDeposit
MarketSvc ..|> IMarket
OrderSvc ..|> IOrder

' Repositories -> Ports Outbound
Repo ..> DomOut : <<implement>>

' Adapters -> Ports Outbound
OtpAdapter ..> DomOut : <<implement>>
KycAdapter ..> DomOut : <<implement>>
PayAdapter ..> DomOut : <<implement>>
MarketFeedAdapter ..> DomOut : <<implement>>
SessionAdapter ..> DomOut : <<implement>>
AuditAdapter ..> DomOut : <<implement>>
LedgerAdapter ..> DomOut : <<implement>>

legend right
  **Type**: Vue Développement (4+1) - Organisation des projets .NET
  
  **Stéréotypes de dépendance**:
    - ==> (épais) : Dépendance entre projets (.csproj references)
    - ..> (fin) : Dépendance intra-projet (using statements)
    - <<access>> : Accès aux éléments publics
    - <<import>> : Import des types (using namespace)
    - <<implement>> : Implémentation d'interface
  
  **Principe de dépendance**:
    Infrastructure → Application → Domain
    (Le Domain ne dépend de RIEN)
  
  **Structure des projets**:
    • **Domain**: Entités, règles métier, ports (interfaces)
    • **Application**: Services orchestrateurs, use cases
    • **Infrastructure.Web**: Controllers, Hubs WebSocket, API
    • **Infrastructure.Persistence**: EF Core, repositories, migrations
    • **Infrastructure.Adapters**: Implémentations services externes
    • **Tests**: Tests unitaires, intégration, E2E
  
  **Nouveautés UC-04/05 (✨ = À créer)**:
    • **Domain.Model.Trading**: Ordre.cs, Execution.cs, Position.cs
    • **Domain.Model.MarketData**: Quote.cs, Subscription.cs
    • **Application**: MarketDataService.cs, OrderService.cs
    • **Web**: MarketDataController.cs, OrdersController.cs, MarketDataHub.cs
    • **Persistence**: 4 nouveaux repositories (Order, Position, Quote, Subscription)
    • **Adapters.MarketFeed**: MarketFeedSimAdapter.cs (WebSocket quotes)
    • **Tests**: 4 nouvelles suites de tests à créer
  
  **Tests existants**:
    • **Domain.Tests**: UnitTest1.cs (template de base)
    • **Application.Tests**: UnitTest1.cs (template de base)
    • **E2E.Tests**: SimpleE2ETests.cs (UC-01 Signup, UC-02 Login, UC-03 Deposit)
    • **Infrastructure.Tests**: UnitTest1.cs, RedisCacheAdapterTests.cs, RedisCachePerformanceTests.cs
  
  **Tests à créer (✨)**:
    • **Domain.Tests**: OrderTests.cs, PositionTests.cs
    • **Application.Tests**: MarketDataServiceTests.cs, OrderServiceTests.cs
    • **E2E.Tests**: MarketDataSubscriptionTests.cs, OrderPlacementTests.cs
  
  **Organisation microservices (Étape 2b)**:
    Si refactorisation en microservices:
    - Services.Identity (UC-01, UC-02)
    - Services.Wallet (UC-03)
    - Services.MarketData (UC-04) ✨
    - Services.Orders (UC-05) ✨
    - Services.Reporting
    
    Chaque service répète la structure:
    Domain → Application → Infrastructure.Web/Persistence/Adapters
  
  **État d'implémentation**:
    ✅ UC-01, UC-02 : Implémentés + Tests E2E (SimpleE2ETests.cs)
    🔄 UC-03 : Partiel (manque idempotency) + Tests E2E existants
    ✨ UC-04, UC-05 : À implémenter (structure définie, tests à créer)
end legend

@enduml
