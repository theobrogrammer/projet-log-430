    class "EfAccountRepository.cs" as AccountRepo
    class "EfPortfolioRepository.cs" as PortfolioRepo
    class "EfPayTxRepository.cs" as PayTxRepo
    class "EfOrderRepository.cs ✨" as OrderRepo
    class "EfPositionRepository.cs ✨" as PositionRepo
    class "EfQuoteRepository.cs ✨" as QuoteRepo
    class "EfSubscriptionRepository.cs ✨" as SubRepo
