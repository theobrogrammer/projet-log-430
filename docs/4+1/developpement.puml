  }
  
  package "Configurations" as Config {
    note "Entity configurations\nFluent API mappings" as ConfigNote
  }
  
  class "BrokerXDbContext.cs" as DbContext
}

' =======================
' LAYER 5: INFRASTRUCTURE ADAPTERS (Services externes)
' =======================
package "BrokerX.Infrastructure.Adapters" as Adapters #F8BBD0 {
  package "Otp" {
    class "EmailSmsOtpAdapter.cs" as OtpAdapter
  }
  package "Kyc" {
    class "KycAdapterSim.cs" as KycAdapter
  }
  package "Payment" {
